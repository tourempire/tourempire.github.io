{
  "name": "tour-empire",
  "version": "1.0.1",
  "private": true,
  "description": "Tour Empire — zenei turnémenedzser-szimulátor (natív burok a webes játék köré)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "sync": "npm run build && cap sync",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "assets": "capacitor-assets generate --assetPath store-assets --iconBackgroundColor '#06070a' --iconBackgroundColorDark '#06070a' --splashBackgroundColor '#06070a' --splashBackgroundColorDark '#06070a'",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@capacitor-community/admob": "^7.0.0",
    "cordova-plugin-purchase": "^13.12.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0"
  }
}
